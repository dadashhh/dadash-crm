# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhb...    # service_role key — bypasses RLS

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAF...   # from @BotFather

# ── Manager Telegram notifications ──────────
MANAGER_TG_CHAT_ID=                   # Telegram chat ID of the manager (for enrich notifications)

# ── Worker settings (optional) ────────────────
PORT=3000                             # HTTP health port (Railway sets this automatically)
POLL_INTERVAL_MS=5000                 # ms between alert polls (default 5000)
ENRICH_POLL_MS=10000                  # ms between enrich polls (default 10000)
