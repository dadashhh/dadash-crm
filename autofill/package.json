{
  "name": "dadash-telegram-autofill",
  "version": "1.0.0",
  "description": "Telegram autofill bot + enrich worker — ingests messages, upserts spenders, enriches profiles",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/runWorker.js",
    "backfill:enrich": "node dist/backfill.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/runWorker.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "grammy": "^1.21.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
